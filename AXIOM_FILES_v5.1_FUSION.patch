+function createMediaPreview(input,preview){
+ let urls=[];
+ input.addEventListener('change',()=>{
+   urls.forEach(u=>URL.revokeObjectURL(u));urls=[];preview.innerHTML='';
+   [...input.files].forEach(f=>{
+     const u=URL.createObjectURL(f);urls.push(u);
+     const d=document.createElement('div');
+     if(f.type.startsWith('image/')) d.innerHTML=`<img src="${u}" style="max-width:120px;max-height:120px"><div>${f.name}</div>`;
+     else if(f.type.startsWith('video/')) d.innerHTML=`<video controls src="${u}" style="max-width:180px"></video><div>${f.name}</div>`;
+     else if(f.type.startsWith('audio/')) d.innerHTML=`<audio controls src="${u}"></audio><div>${f.name}</div>`;
+     else d.innerHTML=`📎 ${f.name}`;
+     preview.appendChild(d);
+   });
+ });
